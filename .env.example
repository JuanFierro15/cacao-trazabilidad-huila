# Copiar este archivo como .env en la raíz del repositorio y ajustar los valores.
# .env nunca se sube al repositorio. Aquí no hay secretos reales.

# --- PostgreSQL (docker-compose y backend) ---
POSTGRES_DB=cacao
POSTGRES_USER=cacao
POSTGRES_PASSWORD=cambiar_clave_local
DB_HOST=localhost
DB_PORT=5433

# --- Backend ---
# Mínimo 32 caracteres. Generar uno propio, por ejemplo: openssl rand -base64 48
JWT_SECRET=cambiar_por_una_cadena_aleatoria_de_minimo_32_caracteres
JWT_EXPIRACION_MINUTOS=480
APP_UMBRAL_MERMA=15.0
APP_CORS_ORIGENES=http://localhost:5173

# --- Frontend (Vite solo expone variables con prefijo VITE_) ---
# Vacío = usa la dirección actual del navegador. Para abrir el QR desde el celular:
# VITE_PUBLIC_BASE_URL=http://<IP-del-PC-en-la-red>:5173
VITE_PUBLIC_BASE_URL=
VITE_USE_MOCKS=false
